model Product {
  id                String                 @id @default(auto()) @map("_id") @db.ObjectId
  v                 Int                    @default(0) @map("__v")
  cartLabel         String                 @unique(map: "cartLabel_1")
  createdAt         DateTime               @default(now()) @db.Date
  description       String
  featuredImageText String?
  featuresText      String[]
  fullLabel         String[]
  isNewProduct      Boolean                @default(true)
  name              String                 @unique(map: "name_1")
  price             Int
  shortLabel        String                 @unique(map: "shortLabel_1")
  showCaseImageText String?
  category          Category               @relation(fields: [categoryId], references: [id])
  categoryId        String                 @db.ObjectId
  includedItems     ProductIncludedItems[]
  images            ProductImages
  slug              String                 @unique(map: "slug_1")
  configFeatured    Config?                @relation("featuredProduct")
  configShowCaseCover Config?              @relation("showCaseCover")
  configShowCaseGrid Config?               @relation("showCaseGrid")
  configShowCaseWide Config?               @relation("showCaseWide")
  cartItems         CartItem[]
  orderItems        OrderItem[]
}

type ProductIncludedItems {
  item     String
  quantity Int
}

type ProductImages {
  featuredImage       ResponsiveImage?
  galleryImages       ResponsiveImage[]
  introImage          ResponsiveImage
  primaryImage        ResponsiveImage
  showCaseImage       ResponsiveImage?
  thumbnail           SingleImage
  relatedProductImage ResponsiveImage
}
