model Category {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  name      NAME        @unique(map: "name_1")
  thumbnail SingleImage
  products  Product[]
  createdAt DateTime    @default(now()) @db.Date
  v         Int         @default(0) @map("__v")
}

enum NAME {
  Headphones
  Earphones
  Speakers
}
