{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["node"],
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "prisma.config.ts", "generated/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", ".turbo/**"]
}
