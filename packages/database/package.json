{
  "name": "@repo/database",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./seed/categories": {
      "types": "./dist/src/seed/categories.seed.d.ts",
      "import": "./dist/src/seed/categories.seed.js",
      "default": "./dist/src/seed/categories.seed.js"
    },
    "./seed/products": {
      "types": "./dist/src/seed/products.seed.d.ts",
      "import": "./dist/src/seed/products.seed.js",
      "default": "./dist/src/seed/products.seed.js"
    },
    "./seed/catalogue-sync": {
      "types": "./dist/src/seed/catalogue-sync.d.ts",
      "import": "./dist/src/seed/catalogue-sync.js",
      "default": "./dist/src/seed/catalogue-sync.js"
    }
  },
  "scripts": {
    "dev": "pnpm db:generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx src/seed/index.ts",
    "db:sync": "tsx src/seed/sync.ts",
    "db:deploy": "pnpm db:push && pnpm db:generate",
    "db:setup": "pnpm db:push && pnpm db:generate && pnpm db:seed",
    "db:reset": "pnpm db:push --force-reset && pnpm db:generate && pnpm db:seed",
    "studio": "prisma studio",
    "format": "prisma format",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json -w"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "prisma": "^6.19.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  }
}
