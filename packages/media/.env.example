# Credentials for `pnpm media:sync`. They belong to the developer running the
# upload, never to the deployed server, so they live here and not in
# apps/server/.env.
#
# Cloudflare dashboard > R2 > Manage API tokens: an Object Read & Write token
# scoped to the audiophile-media bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=audiophile-media
