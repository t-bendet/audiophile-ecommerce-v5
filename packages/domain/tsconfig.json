{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist/src",
    "declaration": true,
    "skipLibCheck": true,
    "composite": true,
    "disableSourceOfProjectReferenceRedirect": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"],
  "references": [{ "path": "../database" }]
}
