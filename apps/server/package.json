{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsup",
    "build:tsc": "NODE_OPTIONS='--max-old-space-size=8192' tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit && pnpm type-check:worker",
    "type-check:worker": "wrangler types worker/worker-configuration.d.ts --include-env=false && tsc -p worker/tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "deploy": "wrangler deploy",
    "deploy:ci": "wrangler deploy --config wrangler.ci.jsonc",
    "dev:worker": "wrangler dev",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/database": "workspace:*",
    "@repo/domain": "workspace:*",
    "cookie-parser": "^1.4.7",
    "dotenv": "catalog:",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "figlet": "^1.12.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "eslint": "catalog:",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.157.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
