{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "composite": false,
    "sourceMap": true,
    "noEmitOnError": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "assumeChangesOnlyAffectDirectDependencies": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "src/seed/**",
    "../node_modules",
    "../../node_modules",
    "../../packages/database/generated/**"
  ]
}
