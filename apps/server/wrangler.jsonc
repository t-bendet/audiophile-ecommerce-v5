{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audiophile-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "API_CONTAINER", "class_name": "ApiContainer" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }],
  "vars": {
    "NODE_ENV": "production",
    "JWT_EXPIRES_IN": "7d",
    "JWT_COOKIE_EXPIRES_IN": "7",
  },
}
