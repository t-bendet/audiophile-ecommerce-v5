# Local development only; in production these come from the Worker and the Dockerfile (see CLAUDE.md).
NODE_ENV=development
PORT=8000
JWT_EXPIRES_IN=7d
JWT_SECRET=AtLeast32CharactersLongSecretKeyForJWTs
JWT_COOKIE_EXPIRES_IN=7
DATABASE_URL=mongodb://localhost:27017/audiophile?replicaSet=rs0&directConnection=true
MEDIA_BASE_URL=https://audiophile-media.t-bendet.com
LOG_LEVEL=debug
