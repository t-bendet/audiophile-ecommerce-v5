# Local development only. In production these come from the Worker: NODE_ENV,
# JWT_EXPIRES_IN and JWT_COOKIE_EXPIRES_IN are `vars` in wrangler.jsonc, DATABASE_URL
# and JWT_SECRET are Worker secrets, and PORT comes from the Dockerfile.
NODE_ENV=development
PORT=8000
JWT_EXPIRES_IN=7d
JWT_SECRET=AtLeast32CharactersLongSecretKeyForJWTs
JWT_COOKIE_EXPIRES_IN=7
DATABASE_URL=mongodb://localhost:27017/audiophile?replicaSet=rs0&directConnection=true
LOG_LEVEL=debug
