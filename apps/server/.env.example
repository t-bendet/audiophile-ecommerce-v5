# Local development only; in production these come from the Worker and the Dockerfile (see AGENTS.md).
NODE_ENV=development
PORT=8000
JWT_EXPIRES_IN=7d
JWT_SECRET=AtLeast32CharactersLongSecretKeyForJWTs
JWT_COOKIE_EXPIRES_IN=7
DATABASE_URL=mongodb://localhost:27017/audiophile?replicaSet=rs0&directConnection=true
MEDIA_BASE_URL=https://audiophile-media.t-bendet.com
EMAIL_FROM=no-reply@audiophile.t-bendet.com
# Unset in development: the rendered email is logged instead of sent. Set a Resend key to send for real.
# EMAIL_API_KEY=
LOG_LEVEL=debug
