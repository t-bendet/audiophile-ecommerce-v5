# Client port
VITE_APP_PORT=5173

# API URL - the path used by axios in the browser
# Development: relative path, Vite proxy forwards to backend
# Production: same origin, the Worker routes /api/* to the API container
# (a shell value beats every .env file: `VITE_APP_API_URL=/api/v1 pnpm build`)
VITE_APP_API_URL=/api/v1

# Proxy target - only used by Vite dev/preview server (not exposed to browser)
VITE_APP_API_PROXY_TARGET=http://localhost:8000
